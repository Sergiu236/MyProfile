---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import Icon from "@components/Icon.astro"
---

<PageLayout title="Lost in transit" description="This page does not exist — or has drifted out of orbit.">
  <section class="flex min-h-[80svh] items-center py-40">
    <Container size="default" class="text-center">
      <p class="eyebrow" data-rise style="--rise-delay: 0ms">Signal lost</p>

      <p
        class="neon mt-8 font-display text-[clamp(5rem,18vw,13rem)] font-semibold leading-none tracking-[-0.05em]"
        data-rise
        style="--rise-delay: 90ms"
      >
        404
      </p>

      <h1 class="mt-6 text-h2" data-rise style="--rise-delay: 170ms">
        There is nothing at these coordinates.
      </h1>

      <p class="mx-auto mt-6 max-w-md text-lead text-mist" data-rise style="--rise-delay: 250ms">
        The page drifted out of orbit, or it never existed. Either way, the way back is lit.
      </p>

      <div
        class="mt-12 flex flex-wrap items-center justify-center gap-4"
        data-rise
        style="--rise-delay: 330ms"
      >
        <a href="/" class="btn btn-primary" data-magnetic="0.18">
          Return home
          <Icon name="arrow-right" class="size-4" />
        </a>
        <a href="/work" class="btn btn-ghost" data-magnetic="0.18">
          <Icon name="layers" class="size-4" />
          View experience
        </a>
      </div>
    </Container>
  </section>
</PageLayout>
