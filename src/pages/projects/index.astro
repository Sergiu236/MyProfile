---
import PageLayout from "@layouts/PageLayout.astro"
import PageHeader from "@components/PageHeader.astro"
import Container from "@components/Container.astro"
import ProjectCard from "@components/ProjectCard.astro"
import { PROJECTS } from "@consts"
import { getProjects } from "@lib/content"

const projects = await getProjects()
---

<PageLayout
  title={PROJECTS.TITLE}
  description={PROJECTS.META_DESCRIPTION}
  seoTitle={PROJECTS.SEO_TITLE}
  breadcrumbs={[{ name: PROJECTS.TITLE, href: "/projects" }]}
>
  <PageHeader
    kicker={PROJECTS.KICKER}
    title="Things I built because the problem would not leave me alone."
    description={PROJECTS.DESCRIPTION}
  />

  <section class="pb-16">
    <Container size="wide">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </Container>
  </section>

</PageLayout>
