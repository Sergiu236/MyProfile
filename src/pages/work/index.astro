---
import PageLayout from "@layouts/PageLayout.astro"
import PageHeader from "@components/PageHeader.astro"
import Container from "@components/Container.astro"
import Timeline from "@components/Timeline.astro"
import Icon from "@components/Icon.astro"
import { CERTIFICATIONS, EDUCATION, WORK } from "@consts"
import { getRoles } from "@lib/content"

const collection = await getRoles()

const roles = await Promise.all(
  collection.map(async (role) => {
    const { Content } = await role.render()
    return { ...role, Content }
  }),
)

const current = collection.find((role) => typeof role.data.dateEnd === "string")

// The three questions a recruiter answers before reading anything else
const answers = [
  { label: "Currently", value: current ? current.data.company : "Available", icon: "zap" },
  { label: "Focus", value: "Distributed systems", icon: "layers" },
  { label: "Based in", value: "Romania", icon: "map-pin" },
]
---

<PageLayout
  title={WORK.TITLE}
  description={WORK.META_DESCRIPTION}
  seoTitle={WORK.SEO_TITLE}
  breadcrumbs={[{ name: WORK.TITLE, href: "/work" }]}
>
  <PageHeader kicker={WORK.KICKER} title="What I was hired to fix, and what actually changed because of it." />

  <!-- ── Fast answers ───────────────────────────────────────── -->
  <section class="pb-16">
    <Container size="wide">
      <ul class="grid gap-px overflow-hidden rounded-2xl border border-[--line] bg-[--line] sm:grid-cols-3" data-reveal-stagger="90">
        {
          answers.map((answer) => (
            <li class="bg-void/85 p-7" data-reveal>
              <p class="flex items-center gap-2 font-sans text-[0.68rem] uppercase tracking-[0.2em] text-glow/60">
                <Icon name={answer.icon} class="size-3.5" />
                {answer.label}
              </p>
              <p class="mt-4 text-[1.15rem] leading-snug text-starlight">{answer.value}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- ── The timeline ───────────────────────────────────────── -->
  <section class="pb-24">
    <Container size="wide">
      <p class="eyebrow mb-14" data-reveal>The timeline</p>
      <Timeline roles={roles} />
    </Container>
  </section>

  <!-- ── Education & certifications ─────────────────────────── -->
  <section class="pb-8">
    <Container size="wide">
      <div class="rule mb-16" data-reveal></div>

      <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
        <div data-reveal>
          <h2 class="flex items-center gap-3 font-sans text-[0.72rem] uppercase tracking-[0.2em] text-glow/70">
            <Icon name="book-open" class="size-4" />
            Education
          </h2>

          <ul class="mt-8 space-y-7">
            {
              EDUCATION.map((entry) => (
                <li class="border-l border-[--line] pl-6">
                  <p class="text-[1.15rem] text-starlight">{entry.DEGREE}</p>
                  <p class="mt-1.5 text-mist">{entry.SCHOOL}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div data-reveal>
          <h2 class="flex items-center gap-3 font-sans text-[0.72rem] uppercase tracking-[0.2em] text-glow/70">
            <Icon name="award" class="size-4" />
            Certifications
          </h2>

          <ul class="mt-8 space-y-7">
            {
              CERTIFICATIONS.map((entry) => (
                <li class="border-l border-[--line] pl-6">
                  <p class="text-[1.15rem] text-starlight">{entry.NAME}</p>
                  <p class="mt-1.5 font-sans text-[0.8rem] uppercase tracking-[0.12em] text-mist">
                    {entry.CODE}
                  </p>
                  <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-nebula/40 bg-nebula/10 px-3 py-1 font-sans text-[0.65rem] uppercase tracking-[0.16em] text-nebula">
                    <span class="size-1.5 animate-pulse rounded-full bg-nebula" />
                    {entry.STATUS}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="mt-16 flex justify-center">
        <!-- Trailing slash matters: without it the host 302s /about → /about/, and
             Astro's router adopts the redirect URL, which drops the #fragment. -->
        <a href="/about/#instruments" class="btn btn-ghost" data-magnetic="0.16">
          <Icon name="layers" class="size-4" />
          See all skills
        </a>
      </div>
    </Container>
  </section>

</PageLayout>
