---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import Portrait from "@components/Portrait.astro"
import Icon from "@components/Icon.astro"
import MetricGrid from "@components/MetricGrid.astro"
import SectionHeading from "@components/SectionHeading.astro"
import ProjectCard from "@components/ProjectCard.astro"
import PostRow from "@components/PostRow.astro"
import ContactBand from "@components/ContactBand.astro"
import { METRICS, SITE } from "@consts"
import { getPosts, getProjects } from "@lib/content"

const posts = (await getPosts()).slice(0, 3)
const projects = (await getProjects()).slice(0, 3)
---

<PageLayout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <!-- ══════════════════════════════════════════════════════════
       HERO — the threshold
       ══════════════════════════════════════════════════════════ -->
  <section class="relative flex min-h-[100svh] items-center overflow-hidden pb-24 pt-36">
    <!-- The horizon: light cresting over an unseen planet -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[70vh]"
      style="background: radial-gradient(70% 100% at 50% 0%, rgba(228,228,231,.12), transparent 65%);"
      aria-hidden="true"
    >
    </div>

    <Container size="wide">
      <div class="grid items-center gap-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <!-- Words -->
        <div class="order-2 lg:order-1">
          <p
            class="inline-flex items-center gap-2.5 rounded-full border border-[--line] bg-void/50 px-4 py-2"
            data-rise
            style="--rise-delay: 0ms"
          >
            <span class="relative flex size-2">
              <span
                class="absolute inline-flex size-full animate-ping rounded-full bg-nebula opacity-70"
              ></span>
              <span class="relative inline-flex size-2 rounded-full bg-nebula"></span>
            </span>
            <span class="font-sans text-[0.7rem] uppercase tracking-[0.16em] text-mist">
              {SITE.LOCATION} · {SITE.AVAILABILITY}
            </span>
          </p>

          <h1 class="mt-8 text-hero">
            <span class="block" data-rise style="--rise-delay: 90ms">Sergiu</span>
            <span class="neon block" data-rise style="--rise-delay: 170ms">Mocan</span>
          </h1>

          <p
            class="mt-7 font-sans text-[0.82rem] uppercase tracking-[0.2em] text-mist"
            data-rise
            style="--rise-delay: 250ms"
          >
            {SITE.ROLE}
          </p>

          <p
            class="mt-8 max-w-xl text-lead leading-relaxed text-mist"
            data-rise
            style="--rise-delay: 320ms"
          >
            I take systems that were never built to scale — a twenty-year-old desktop monolith, a
            process run by hand every morning — and rebuild them into cloud-native platforms that
            hold up under real load.
          </p>

          <div
            class="mt-11 flex flex-wrap items-center gap-4"
            data-rise
            style="--rise-delay: 400ms"
          >
            <a href="/work" class="btn btn-primary" data-magnetic="0.16">
              Enter the work
              <Icon name="arrow-right" class="size-4" />
            </a>

            <a href={SITE.CV} download class="btn btn-ghost" data-magnetic="0.16">
              <Icon name="download" class="size-4" />
              Download CV
            </a>
          </div>
        </div>

        <!-- Face -->
        <div class="order-1 mx-auto w-full max-w-[19rem] lg:order-2 lg:max-w-[26rem]">
          <div data-rise style="--rise-delay: 60ms">
            <Portrait />
          </div>
        </div>
      </div>
    </Container>

    <!-- Scroll cue -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-8 hidden flex-col items-center gap-3 lg:flex"
      data-rise
      style="--rise-delay: 620ms"
      aria-hidden="true"
    >
      <span class="font-sans text-[0.62rem] uppercase tracking-[0.3em] text-dim">Descend</span>
      <span class="h-14 w-px bg-gradient-to-b from-glow/60 to-transparent"></span>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       IMPACT — the numbers, before anything else
       ══════════════════════════════════════════════════════════ -->
  <section class="py-20">
    <Container size="wide">
      <p class="eyebrow mb-8" data-reveal>Impact in production</p>
      <MetricGrid metrics={METRICS} />
    </Container>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       POSITIONING
       ══════════════════════════════════════════════════════════ -->
  <section class="py-20">
    <Container size="wide">
      <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="eyebrow" data-reveal>The short version</p>
          <div class="mt-8 hidden h-px w-24 bg-glow/40 lg:block" data-reveal></div>
        </div>

        <div class="space-y-8" data-reveal>
          <p class="text-[clamp(1.35rem,1rem+1.2vw,1.9rem)] font-normal leading-[1.45] text-starlight">
            <span class="neon font-semibold">Legacy systems are not old code.</span> They
            are decisions made under constraints that no longer exist, still running a business that
            has moved on.
          </p>

          <p class="max-w-2xl text-body-lg leading-relaxed text-mist">
            At <strong class="font-semibold text-starlight">TSS Yonder</strong> I lead the migration
            of a Dealer Management System used by 750+ automotive businesses across Western Europe,
            from a VB6 desktop application to ASP.NET Core and React on AWS — infrastructure
            provisioned from scratch with CDK, core services split into Fargate microservices, and
            deploys that no longer require anyone to hold their breath.
          </p>

          <p class="max-w-2xl text-body-lg leading-relaxed text-mist">
            Outside of production I build things that force me to be precise: a nine-contract
            Ethereum voting system where correctness has to be provable, and a Hamiltonian neural
            network that refuses to violate conservation of energy. Both are exercises in the same
            discipline — get the structure right and the behaviour follows.
          </p>

          <a href="/about" class="link-glow inline-flex items-center gap-2 pt-2 font-sans text-[0.78rem] uppercase tracking-[0.16em]">
            The longer version
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       SELECTED WORK
       ══════════════════════════════════════════════════════════ -->
  <section class="py-20">
    <Container size="wide">
      <SectionHeading
        kicker="Selected work"
        title="Systems built end to end"
        href="/projects"
        linkText="All projects"
      />

      <div class="mt-6">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </Container>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       WRITING
       ══════════════════════════════════════════════════════════ -->
  <section class="py-20">
    <Container size="wide">
      <SectionHeading
        kicker="Transmissions"
        title="Recent writing"
        href="/blog"
        linkText="All posts"
      />

      <div class="mt-6">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </Container>
  </section>

  <ContactBand />
</PageLayout>
