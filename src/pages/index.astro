---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import Portrait from "@components/Portrait.astro"
import Icon from "@components/Icon.astro"
import SectionHeading from "@components/SectionHeading.astro"
import ProjectCard from "@components/ProjectCard.astro"
import PostRow from "@components/PostRow.astro"
import ContactBand from "@components/ContactBand.astro"
import { SITE } from "@consts"
import { getPosts, getProjects } from "@lib/content"

const posts = (await getPosts()).slice(0, 1)
const projects = (await getProjects()).slice(0, 1)
---

<PageLayout title={SITE.TITLE} description={SITE.META_DESCRIPTION} seoTitle={SITE.SEO_TITLE}>
  <!-- ══════════════════════════════════════════════════════════
       HERO — the threshold
       ══════════════════════════════════════════════════════════ -->
  <section class="relative flex min-h-[100svh] items-center overflow-hidden pb-24 pt-36">
    <!-- The horizon: light cresting over an unseen planet -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[70vh]"
      style="background: radial-gradient(70% 100% at 50% 0%, rgba(228,228,231,.12), transparent 65%);"
      aria-hidden="true"
    >
    </div>

    <Container size="wide">
      <div class="grid items-center gap-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <!-- Words -->
        <div class="order-2 lg:order-1">
          <h1 class="text-hero">
            <span class="block" data-rise style="--rise-delay: 90ms">Sergiu</span>
            <span class="neon block" data-rise style="--rise-delay: 170ms">Mocan</span>
          </h1>

          <p
            class="mt-7 font-sans text-[0.82rem] uppercase tracking-[0.2em] text-mist"
            data-rise
            style="--rise-delay: 250ms"
          >
            {SITE.ROLE}
          </p>

          <p
            class="mt-8 max-w-xl text-lead leading-relaxed text-mist"
            data-rise
            style="--rise-delay: 320ms"
          >
            I turn chaotic requirements into fault tolerant backends, 
            observable pipelines, and resilient cloud architecture. 
            Reliability isn't a fire drill. It's the quiet baseline 
            I build in from day one.
          </p>

          <div
            class="mt-11 flex flex-wrap items-center gap-4"
            data-rise
            style="--rise-delay: 400ms"
          >
            <a href="/work" class="btn btn-primary" data-magnetic="0.16">
              Experience
            </a>

            <a href={SITE.CV} download class="btn btn-ghost" data-magnetic="0.16">
              <Icon name="download" class="size-4" />
              Download CV
            </a>
          </div>
        </div>

        <!-- Face -->
        <div class="order-1 mx-auto w-full max-w-[19rem] lg:order-2 lg:max-w-[26rem]">
          <div data-rise style="--rise-delay: 60ms">
            <Portrait />
          </div>
        </div>
      </div>
    </Container>

    <!-- Scroll cue -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-8 hidden flex-col items-center gap-3 lg:flex"
      data-rise
      style="--rise-delay: 620ms"
      aria-hidden="true"
    >
      <span class="font-sans text-[0.62rem] uppercase tracking-[0.3em] text-dim">Descend</span>
      <span class="h-14 w-px bg-gradient-to-b from-glow/60 to-transparent"></span>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       POSITIONING
       ══════════════════════════════════════════════════════════ -->
  <section class="py-20">
    <Container size="wide">
      <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="eyebrow" data-reveal>The short version</p>
          <div class="mt-8 hidden h-px w-24 bg-glow/40 lg:block" data-reveal></div>
        </div>

        <div class="space-y-8" data-reveal>
          <p class="text-[clamp(1.35rem,1rem+1.2vw,1.9rem)] font-normal leading-[1.45] text-starlight">
            <span class="neon font-semibold">Driven by curiosity.</span>
          </p>

          <p class="max-w-2xl text-body-lg leading-relaxed text-mist">
            It started with a simple obsession: the invisible journey of data. I wanted to know
            exactly what happens in that microsecond between pressing a key on a keyboard and a
            character appearing on a screen.
          </p>

          <p class="max-w-2xl text-body-lg leading-relaxed text-mist">
            Pulling that thread didn't just give me answers; it pulled me into a world that feels
            entirely without end. To me, technology is like deep space, the further you travel into
            it, the more the horizon expands. There is always another layer of abstraction to peel
            back, another hidden mechanism to uncover.
          </p>

          <a href="/about" class="link-glow inline-flex items-center gap-2 pt-2 font-sans text-[0.78rem] uppercase tracking-[0.16em]">
            The longer version
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       SELECTED WORK
       ══════════════════════════════════════════════════════════ -->
  <section class="py-20">
    <Container size="wide">
      <SectionHeading kicker="Selected work" title="Systems built end to end" />

      <div class="mt-6">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/projects"
          class="link-glow group inline-flex items-center gap-2 font-sans text-[0.78rem] uppercase tracking-[0.16em]"
        >
          See all projects
          <Icon
            name="arrow-right"
            class="size-4 transition-transform duration-500 ease-portal group-hover:translate-x-1.5"
          />
        </a>
      </div>
    </Container>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       WRITING
       ══════════════════════════════════════════════════════════ -->
  {
    posts.length > 0 && (
      <section class="py-20">
        <Container size="wide">
          <SectionHeading kicker="Transmissions" title="Recent writing" />

          <div class="mt-6">
            {posts.map((post) => <PostRow post={post} />)}
          </div>

          <div class="mt-10 flex justify-center">
            <a
              href="/blog"
              class="link-glow group inline-flex items-center gap-2 font-sans text-[0.78rem] uppercase tracking-[0.16em]"
            >
              See all posts
              <Icon
                name="arrow-right"
                class="size-4 transition-transform duration-500 ease-portal group-hover:translate-x-1.5"
              />
            </a>
          </div>
        </Container>
      </section>
    )
  }

  <ContactBand />
</PageLayout>
