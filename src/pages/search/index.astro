---
import PageLayout from "@layouts/PageLayout.astro"
import PageHeader from "@components/PageHeader.astro"
import Container from "@components/Container.astro"
import Icon from "@components/Icon.astro"
import { SEARCH, getSection } from "@consts"
import { getPosts, getProjects } from "@lib/content"
import { formatDate } from "@lib/utils"

const posts = await getPosts()
const projects = await getProjects()

// One flat, sortable index over both collections
const entries = [
  ...posts.map((post) => ({
    kind: "Post",
    href: `/blog/${post.slug}`,
    title: post.data.title,
    summary: post.data.summary,
    date: post.data.date,
    tags: post.data.tags,
    context: getSection(post.data.section)?.LABEL ?? "",
  })),
  ...projects.map((project) => ({
    kind: "Project",
    href: `/projects/${project.slug}`,
    title: project.data.title,
    summary: project.data.summary,
    date: project.data.date,
    tags: project.data.tags,
    context: project.data.status,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime())
---

<PageLayout
  title={SEARCH.TITLE}
  description={SEARCH.DESCRIPTION}
  breadcrumbs={[{ name: SEARCH.TITLE, href: "/search" }]}
>
  <PageHeader kicker={SEARCH.KICKER} title="Search everything." description={SEARCH.DESCRIPTION} />

  <section class="pb-24">
    <Container size="wide">
      <div class="group relative" data-reveal>
        <Icon
          name="search"
          class="pointer-events-none absolute left-0 top-1/2 size-6 -translate-y-1/2 text-dim transition-colors duration-300 group-focus-within:text-glow"
        />
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          autofocus
          placeholder="Posts, projects, technologies…"
          aria-label="Search posts and projects"
          class="w-full border-0 border-b border-[--line] bg-transparent py-6 pl-11 pr-4 text-[clamp(1.2rem,1rem+1vw,1.7rem)] text-starlight outline-none transition-colors duration-300 placeholder:text-dim focus:border-glow/60 focus:ring-0"
        />
      </div>

      <p
        id="search-count"
        class="mt-8 font-sans text-[0.72rem] uppercase tracking-[0.16em] text-dim"
        aria-live="polite"
      >
        {entries.length} entries in the archive
      </p>

      <ul id="search-results" class="mt-6">
        {
          entries.map((entry) => (
            <li
              class="search-row group relative border-t border-[--line]"
              data-search={[entry.title, entry.summary, entry.context, entry.kind, ...entry.tags]
                .join(" ")
                .toLowerCase()}
            >
              <div
                class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                style="background: linear-gradient(90deg, rgba(228,228,231,.07), transparent 55%);"
                aria-hidden="true"
              />

              <a href={entry.href} class="relative block py-8 pl-6">
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                  <span class="rounded-full border border-[--line] px-2.5 py-0.5 font-sans text-[0.65rem] uppercase tracking-[0.16em] text-glow/80">
                    {entry.kind}
                  </span>
                  <span class="font-sans text-[0.7rem] uppercase tracking-[0.14em] text-dim">
                    {formatDate(entry.date)}
                  </span>
                  {entry.context && (
                    <span class="font-sans text-[0.7rem] uppercase tracking-[0.14em] text-amethyst-mist">
                      {entry.context}
                    </span>
                  )}
                </div>

                <h2 class="mt-4 text-h3 text-starlight transition-colors duration-300 group-hover:text-glow">
                  {entry.title}
                </h2>

                <p class="mt-2.5 max-w-2xl leading-relaxed text-mist">{entry.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>

      <div id="search-empty" hidden class="border-t border-[--line] py-24 text-center">
        <p class="font-display text-h3 text-starlight">No signal on that frequency.</p>
        <p class="mt-3 text-mist">Try a shorter word, or a technology name.</p>
      </div>
    </Container>
  </section>
</PageLayout>

<script>
  /** Filters the pre-rendered archive rows as you type. */
  function initSearch() {
    const input = document.getElementById("search-input") as HTMLInputElement | null
    const results = document.getElementById("search-results")
    const empty = document.getElementById("search-empty")
    const count = document.getElementById("search-count")
    if (!input || !results || !empty || !count) return

    const rows = Array.from(results.querySelectorAll<HTMLElement>(".search-row"))

    const apply = () => {
      const query = input.value.trim().toLowerCase()
      let visible = 0

      for (const row of rows) {
        const show = !query || (row.dataset.search ?? "").includes(query)
        row.hidden = !show
        if (show) visible += 1
      }

      count.textContent = query
        ? `${visible} of ${rows.length} entries match “${input.value.trim()}”`
        : `${rows.length} entries in the archive`
      empty.hidden = visible > 0
    }

    input.addEventListener("input", apply)
    apply()
  }

  document.addEventListener("astro:page-load", initSearch)
</script>
