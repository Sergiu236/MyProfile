---
import type { CollectionEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import Icon from "@components/Icon.astro"
import PostRow from "@components/PostRow.astro"
import ArticleNav from "@components/ArticleNav.astro"
import { getSection } from "@consts"
import { getPosts, getRelated } from "@lib/content"
import { formatDate, readingTime, slugify } from "@lib/utils"

export async function getStaticPaths() {
  const posts = await getPosts()

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      // Posts are newest-first, so the *previous* index is the newer post
      newer: posts[index - 1],
      older: posts[index + 1],
      related: getRelated(post, posts),
    },
  }))
}

type Props = {
  post: CollectionEntry<"blog">
  newer?: CollectionEntry<"blog">
  older?: CollectionEntry<"blog">
  related: CollectionEntry<"blog">[]
}

const { post, newer, older, related } = Astro.props
const { title, summary, date, updated, section, tags } = post.data
const meta = getSection(section)
const { Content } = await post.render()
---

<PageLayout
  title={title}
  description={summary}
  article={{ published: date, modified: updated, section: meta?.LABEL, tags }}
  breadcrumbs={[
    { name: "Blog", href: "/blog" },
    { name: title, href: `/blog/${post.slug}` },
  ]}
>
  <!-- ── Article header ─────────────────────────────────────── -->
  <section class="relative pb-14 pt-40 sm:pt-48">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-96 opacity-70"
      style="background: radial-gradient(60% 100% at 50% 0%, rgba(177,78,255,.16), transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <Container size="reading">
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 font-sans text-[0.72rem] uppercase tracking-[0.16em] text-dim transition-colors duration-300 hover:text-glow"
      >
        <Icon
          name="arrow-right"
          class="size-4 rotate-180 transition-transform duration-500 ease-portal group-hover:-translate-x-1.5"
        />
        All posts
      </a>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        {
          meta && (
            <a
              href={`/blog/section/${meta.ID}`}
              class={`inline-flex items-center gap-2 font-sans text-[0.72rem] uppercase tracking-[0.18em] transition-opacity duration-300 hover:opacity-70 ${meta.ACCENT}`}
            >
              <Icon name={meta.ICON} class="size-3.5" />
              {meta.LABEL}
            </a>
          )
        }

        <time
          datetime={date.toISOString()}
          class="font-sans text-[0.72rem] uppercase tracking-[0.14em] text-dim"
        >
          {formatDate(date)}
        </time>

        <span class="inline-flex items-center gap-1.5 font-sans text-[0.72rem] uppercase tracking-[0.14em] text-dim">
          <Icon name="clock" class="size-3.5" />
          {readingTime(post.body)}
        </span>
      </div>

      <h1 class="mt-7 text-h1">{title}</h1>

      <p class="mt-6 text-lead leading-relaxed text-mist">{summary}</p>

      {
        updated && (
          <p class="mt-5 font-sans text-[0.7rem] uppercase tracking-[0.14em] text-dim">
            Updated {formatDate(updated)}
          </p>
        )
      }

      <div class="mt-10 rule"></div>
    </Container>
  </section>

  <!-- ── The article ────────────────────────────────────────── -->
  <section class="pb-16">
    <Container size="reading">
      <div class="article">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="mt-16 border-t border-[--line] pt-8">
            <p class="eyebrow">Filed under</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  <a href={`/blog/tag/${slugify(tag)}`} class="chip chip-link">
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <ArticleNav
        prev={older && { href: `/blog/${older.slug}`, title: older.data.title }}
        next={newer && { href: `/blog/${newer.slug}`, title: newer.data.title }}
      />
    </Container>
  </section>

  <!-- ── Keep reading ───────────────────────────────────────── -->
  {
    related.length > 0 && (
      <section class="pb-24">
        <Container size="wide">
          <div class="rule mb-12" />
          <p class="eyebrow mb-2">Keep reading</p>
          <div class="mt-8">
            {related.map((entry) => (
              <PostRow post={entry} />
            ))}
          </div>
        </Container>
      </section>
    )
  }
</PageLayout>
