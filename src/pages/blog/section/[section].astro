---
import PageLayout from "@layouts/PageLayout.astro"
import PageHeader from "@components/PageHeader.astro"
import Container from "@components/Container.astro"
import PostRow from "@components/PostRow.astro"
import Icon from "@components/Icon.astro"
import { SECTIONS } from "@consts"
import { getPosts, type Post } from "@lib/content"
import type { Section } from "@types"

export async function getStaticPaths() {
  const posts = await getPosts()

  // Only sections that actually have posts get a page
  return SECTIONS.filter((section) => posts.some((post) => post.data.section === section.ID)).map(
    (section) => ({
      params: { section: section.ID },
      props: {
        section,
        posts: posts.filter((post) => post.data.section === section.ID),
      },
    }),
  )
}

type Props = { section: Section; posts: Post[] }

const { section, posts } = Astro.props
---

<PageLayout
  title={`${section.LABEL} — Blog`}
  description={section.DESCRIPTION}
  breadcrumbs={[
    { name: "Blog", href: "/blog" },
    { name: section.LABEL, href: `/blog/section/${section.ID}` },
  ]}
>
  <PageHeader kicker={section.KICKER} title={section.LABEL} description={section.DESCRIPTION}>
    <div class="mt-10 flex flex-wrap items-center gap-6">
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 font-sans text-[0.72rem] uppercase tracking-[0.16em] text-dim transition-colors duration-300 hover:text-glow"
      >
        <Icon
          name="arrow-right"
          class="size-4 rotate-180 transition-transform duration-500 ease-portal group-hover:-translate-x-1.5"
        />
        Every section
      </a>

      <p class="font-sans text-[0.72rem] uppercase tracking-[0.16em] text-dim">
        {posts.length}
        {posts.length === 1 ? "post" : "posts"}
      </p>
    </div>
  </PageHeader>

  <section class="pb-24">
    <Container size="wide">
      {posts.map((post) => <PostRow post={post} />)}
    </Container>
  </section>
</PageLayout>
