---
import PageLayout from "@layouts/PageLayout.astro"
import PageHeader from "@components/PageHeader.astro"
import Container from "@components/Container.astro"
import Icon from "@components/Icon.astro"
import { CONTACT, SITE, SOCIALS } from "@consts"

const channels = [
  {
    label: "Email",
    value: SITE.EMAIL,
    href: `mailto:${SITE.EMAIL}`,
    icon: "mail",
    note: "Fastest route. I read everything.",
    copy: true,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/sergiu-mocan",
    href: SOCIALS.find((social) => social.NAME === "LinkedIn")!.HREF,
    icon: "linkedin",
    note: "For recruiters and introductions.",
    copy: false,
  },
  {
    label: "GitHub",
    value: "github.com/Sergiu236",
    href: SOCIALS.find((social) => social.NAME === "GitHub")!.HREF,
    icon: "github",
    note: "Code, experiments, and the occasional half-finished idea.",
    copy: false,
  },
  {
    label: "Phone",
    value: SITE.PHONE,
    href: `tel:${SITE.PHONE.replace(/\s/g, "")}`,
    icon: "phone",
    note: "For anything time-sensitive.",
    copy: true,
  },
]

---

<PageLayout
  title={CONTACT.TITLE}
  description={CONTACT.DESCRIPTION}
  breadcrumbs={[{ name: CONTACT.TITLE, href: "/contact" }]}
>
  <PageHeader
    kicker={CONTACT.KICKER}
    title="Say something worth building."
    description={CONTACT.DESCRIPTION}
  />

  <!-- ── Channels ───────────────────────────────────────────── -->
  <section class="pb-24">
    <Container size="wide">
      <ul data-reveal-stagger="90">
        {
          channels.map((channel) => (
            <li class="group relative border-b border-[--line] first:border-t" data-reveal>
              <div
                class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                style="background: linear-gradient(90deg, rgba(228,228,231,.07), transparent 55%);"
                aria-hidden="true"
              />

              <div class="relative flex items-start gap-4 py-7 pl-4 pr-4 sm:items-center sm:gap-6 sm:py-8 sm:pl-6 sm:pr-6">
                <Icon
                  name={channel.icon}
                  sprite={channel.icon === "linkedin" || channel.icon === "github" || channel.icon === "mail" ? "social" : "ui"}
                  class="mt-1 size-5 shrink-0 text-glow/60 transition-colors duration-500 group-hover:text-glow sm:mt-0 sm:size-6"
                />

                <div class="flex min-w-0 flex-1 flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                  <div class="min-w-0">
                    <p class="font-sans text-[0.7rem] uppercase tracking-[0.2em] text-dim">
                      {channel.label}
                    </p>
                    <a
                      href={channel.href}
                      target={channel.href.startsWith("http") ? "_blank" : undefined}
                      rel="noopener noreferrer"
                      class="mt-2 block break-all font-display text-[clamp(1.05rem,0.85rem+1vw,1.7rem)] font-medium tracking-[-0.02em] text-starlight transition-colors duration-300 group-hover:text-glow"
                    >
                      {channel.value}
                    </a>
                    <p class="mt-2 text-[0.88rem] text-dim sm:text-[0.92rem]">{channel.note}</p>
                  </div>

                  {channel.copy && (
                    <button
                      type="button"
                      class="copy-value inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-[--line] px-4 py-2 font-sans text-[0.68rem] uppercase tracking-[0.14em] text-mist transition-colors duration-300 hover:border-glow/50 hover:text-glow"
                      data-value={channel.value}
                    >
                      <Icon name="copy" class="size-3.5" />
                      <span class="copy-label">Copy</span>
                    </button>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- ── Get in touch ───────────────────────────────────────── -->
  <section class="pb-24">
    <Container size="wide">
      <div data-reveal>
        <div class="flex flex-wrap items-center gap-4">
          <a href={`mailto:${SITE.EMAIL}`} class="btn btn-primary" data-magnetic="0.16">
            <Icon name="mail" class="size-4" />
            Start a conversation
          </a>
          <a href={SITE.CV} download class="btn btn-ghost" data-magnetic="0.16">
            <Icon name="download" class="size-4" />
            Download CV
          </a>
        </div>

        <p class="mt-10 inline-flex items-center gap-2.5 text-mist">
          <Icon name="map-pin" class="size-4 text-glow/60" />
          Central European Time
        </p>
      </div>
    </Container>
  </section>
</PageLayout>

<script>
  /** Copy-to-clipboard for the email and phone rows. */
  function initCopyValues() {
    document.querySelectorAll<HTMLButtonElement>(".copy-value").forEach((button) => {
      if (button.dataset.bound) return
      button.dataset.bound = "1"

      button.addEventListener("click", async () => {
        const value = button.dataset.value
        const label = button.querySelector(".copy-label")
        if (!value || !label) return

        await navigator.clipboard.writeText(value)
        label.textContent = "Copied"
        setTimeout(() => (label.textContent = "Copy"), 1600)
      })
    })
  }

  document.addEventListener("astro:page-load", initCopyValues)
</script>
