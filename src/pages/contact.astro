---
import PageLayout from "@layouts/PageLayout.astro"
import PageHeader from "@components/PageHeader.astro"
import Container from "@components/Container.astro"
import Icon from "@components/Icon.astro"
import { CONTACT, SITE, SOCIALS } from "@consts"

const channels = [
  {
    label: "Email",
    value: SITE.EMAIL,
    href: `mailto:${SITE.EMAIL}`,
    icon: "mail",
    note: "Fastest route. I read everything.",
    copy: true,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/sergiu-mocan",
    href: SOCIALS.find((social) => social.NAME === "LinkedIn")!.HREF,
    icon: "linkedin",
    note: "For recruiters and introductions.",
    copy: false,
  },
  {
    label: "GitHub",
    value: "github.com/Sergiu236",
    href: SOCIALS.find((social) => social.NAME === "GitHub")!.HREF,
    icon: "github",
    note: "Code, experiments, and the occasional half-finished idea.",
    copy: false,
  },
  {
    label: "Phone",
    value: SITE.PHONE,
    href: `tel:${SITE.PHONE.replace(/\s/g, "")}`,
    icon: "phone",
    note: "For anything time-sensitive.",
    copy: true,
  },
]

const looking = [
  "Senior backend or full-stack roles in .NET and TypeScript",
  "Cloud migration and platform work on AWS",
  "Distributed systems where correctness actually matters",
  "Teams that treat infrastructure as a product, not a chore",
]
---

<PageLayout
  title={CONTACT.TITLE}
  description={CONTACT.DESCRIPTION}
  breadcrumbs={[{ name: CONTACT.TITLE, href: "/contact" }]}
>
  <PageHeader
    kicker={CONTACT.KICKER}
    title="Say something worth building."
    description={CONTACT.DESCRIPTION}
  />

  <!-- ── Channels ───────────────────────────────────────────── -->
  <section class="pb-24">
    <Container size="wide">
      <ul data-reveal-stagger="90">
        {
          channels.map((channel) => (
            <li class="group relative border-b border-[--line] first:border-t" data-reveal>
              <div
                class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                style="background: linear-gradient(90deg, rgba(177,78,255,.09), transparent 55%);"
                aria-hidden="true"
              />

              <div class="relative flex flex-wrap items-center gap-6 py-8 pl-6">
                <Icon
                  name={channel.icon}
                  sprite={channel.icon === "linkedin" || channel.icon === "github" || channel.icon === "mail" ? "social" : "ui"}
                  class="size-6 text-glow/60 transition-colors duration-500 group-hover:text-glow"
                />

                <div class="min-w-0 flex-1">
                  <p class="font-sans text-[0.7rem] uppercase tracking-[0.2em] text-dim">
                    {channel.label}
                  </p>
                  <a
                    href={channel.href}
                    target={channel.href.startsWith("http") ? "_blank" : undefined}
                    rel="noopener noreferrer"
                    class="mt-2 block break-all font-display text-[clamp(1.2rem,1rem+0.9vw,1.7rem)] font-medium tracking-[-0.02em] text-starlight transition-colors duration-300 group-hover:text-glow"
                  >
                    {channel.value}
                  </a>
                  <p class="mt-2 text-[0.92rem] text-dim">{channel.note}</p>
                </div>

                {channel.copy && (
                  <button
                    type="button"
                    class="copy-value inline-flex shrink-0 items-center gap-2 rounded-full border border-[--line] px-4 py-2 font-sans text-[0.68rem] uppercase tracking-[0.14em] text-mist transition-colors duration-300 hover:border-glow/50 hover:text-glow"
                    data-value={channel.value}
                  >
                    <Icon name="copy" class="size-3.5" />
                    <span class="copy-label">Copy</span>
                  </button>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- ── What I am looking for ──────────────────────────────── -->
  <section class="pb-24">
    <Container size="wide">
      <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="eyebrow" data-reveal>Currently open to</p>
        </div>

        <div data-reveal>
          <ul class="space-y-5">
            {
              looking.map((item) => (
                <li class="flex items-start gap-4 text-body-lg leading-relaxed text-mist">
                  <span class="mt-[0.62em] size-2 shrink-0 rotate-45 border border-glow/60 bg-glow/20" />
                  {item}
                </li>
              ))
            }
          </ul>

          <div class="mt-12 flex flex-wrap items-center gap-4">
            <a href={`mailto:${SITE.EMAIL}`} class="btn btn-primary" data-magnetic="0.16">
              <Icon name="mail" class="size-4" />
              Start a conversation
            </a>
            <a href={SITE.CV} download class="btn btn-ghost" data-magnetic="0.16">
              <Icon name="download" class="size-4" />
              Download CV
            </a>
          </div>

          <p class="mt-10 inline-flex items-center gap-2.5 text-mist">
            <Icon name="map-pin" class="size-4 text-glow/60" />
            {SITE.LOCATION} · Central European Time
          </p>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>

<script>
  /** Copy-to-clipboard for the email and phone rows. */
  function initCopyValues() {
    document.querySelectorAll<HTMLButtonElement>(".copy-value").forEach((button) => {
      if (button.dataset.bound) return
      button.dataset.bound = "1"

      button.addEventListener("click", async () => {
        const value = button.dataset.value
        const label = button.querySelector(".copy-label")
        if (!value || !label) return

        await navigator.clipboard.writeText(value)
        label.textContent = "Copied"
        setTimeout(() => (label.textContent = "Copy"), 1600)
      })
    })
  }

  document.addEventListener("astro:page-load", initCopyValues)
</script>
