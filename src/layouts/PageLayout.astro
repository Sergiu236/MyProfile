---
import "@styles/global.css"
import { SITE } from "@consts"
import BaseHead from "@components/BaseHead.astro"
import Atmosphere from "@components/Atmosphere.astro"
import Header from "@components/Header.astro"
import Drawer from "@components/Drawer.astro"
import Footer from "@components/Footer.astro"

type Props = {
  title: string
  description: string
  /**
   * Descriptive title for link previews. Never the browser tab — that
   * always reads just the name. Falls back to "<title> — Sergiu Mocan".
   */
  seoTitle?: string
  image?: string
  article?: {
    published: Date
    modified?: Date
    section?: string
    tags?: string[]
  }
  breadcrumbs?: { name: string; href: string }[]
}

const { title, description, seoTitle, image, article, breadcrumbs } = Astro.props

/* The tab always shows just the name — a deliberate choice.
   The descriptive per-page title still goes out on Open Graph and Twitter
   cards, so a shared link reads properly without changing the tab. */
const pageTitle = SITE.TITLE
const socialTitle = seoTitle ?? `${title} — ${SITE.TITLE}`
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={pageTitle}
      rawTitle={title}
      socialTitle={socialTitle}
      description={description}
      image={image}
      article={article}
      breadcrumbs={breadcrumbs}
    />
  </head>

  <body>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[70] focus:rounded-full focus:bg-glow focus:px-5 focus:py-2.5 focus:text-void"
    >
      Skip to content
    </a>

    <!-- The sky keeps drifting between pages -->
    <Atmosphere transition:persist="atmosphere" />

    <Header />
    <Drawer />

    <main id="content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
