---
import type { Post } from "@lib/content"
import { getSection } from "@consts"
import { formatDate, readingTime, slugify } from "@lib/utils"
import Icon from "@components/Icon.astro"

type Props = {
  post: Post
  /** Adds the data attributes the /blog filter script reads */
  filterable?: boolean
}

const { post, filterable = false } = Astro.props
const { title, summary, date, section, tags } = post.data
const meta = getSection(section)

// Everything the client-side filter matches against, lowercased once here
const haystack = [title, summary, meta?.LABEL, ...tags].filter(Boolean).join(" ").toLowerCase()
---

<article
  class="post-row group relative border-t border-[--line]"
  data-section={filterable ? section : undefined}
  data-tags={filterable ? tags.map(slugify).join(" ") : undefined}
  data-search={filterable ? haystack : undefined}
  data-reveal
>
  <!-- No box — just light pooling behind the row on hover -->
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    style="background: linear-gradient(90deg, rgba(228,228,231,.07), transparent 55%);"
    aria-hidden="true"
  >
  </div>
  <span
    class="pointer-events-none absolute left-0 top-0 h-full w-px origin-top scale-y-0 bg-glow transition-transform duration-500 ease-portal group-hover:scale-y-100"
    aria-hidden="true"></span>

  <a href={`/blog/${post.slug}`} class="relative grid gap-4 py-9 pl-6 pr-2 lg:grid-cols-[12rem_1fr_auto] lg:gap-10">
    <!-- Meta rail -->
    <div class="flex items-center gap-3 lg:block">
      <time
        datetime={date.toISOString()}
        class="font-sans text-[0.75rem] uppercase tracking-[0.14em] text-dim"
      >
        {formatDate(date)}
      </time>

      {
        meta && (
          <p class={`mt-2 font-sans text-[0.7rem] uppercase tracking-[0.16em] ${meta.ACCENT}`}>
            {meta.LABEL}
          </p>
        )
      }
    </div>

    <!-- The post -->
    <div>
      <h3
        class="text-h3 leading-snug text-starlight transition-colors duration-300 group-hover:text-glow"
      >
        {title}
      </h3>

      <p class="mt-3 max-w-2xl leading-relaxed text-mist">{summary}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
        <span class="inline-flex items-center gap-1.5 font-sans text-[0.7rem] uppercase tracking-[0.12em] text-dim">
          <Icon name="clock" class="size-3.5" />
          {readingTime(post.body)}
        </span>

        {
          tags.slice(0, 4).map((tag) => (
            <span class="font-sans text-[0.7rem] uppercase tracking-[0.12em] text-amethyst-mist">
              #{tag}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Arrow -->
    <div class="hidden items-center lg:flex">
      <Icon
        name="arrow-right"
        class="size-6 text-amethyst-mist transition-all duration-500 ease-portal group-hover:translate-x-2 group-hover:text-glow"
      />
    </div>
  </a>
</article>
