---
import type { Project } from "@lib/content"
import Icon from "@components/Icon.astro"

type Props = {
  project: Project
  index: number
}

const { project, index } = Astro.props
const { title, summary, period, status, role, tags, metrics } = project.data
---

<a
  href={`/projects/${project.slug}`}
  class="group relative block overflow-hidden border-t border-[--line] py-12 transition-colors duration-500 first:border-t-0"
  data-reveal
>
  <!-- Light gathers behind the card as you approach it -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-700 ease-portal group-hover:opacity-100"
    style="background: radial-gradient(70% 120% at 0% 50%, rgba(228,228,231,.09), transparent 65%);"
    aria-hidden="true"
  >
  </div>

  <!-- A bar of light grows down the left edge on hover -->
  <span
    class="pointer-events-none absolute left-0 top-0 h-full w-px origin-top scale-y-0 bg-gradient-to-b from-glow via-nebula to-transparent transition-transform duration-700 ease-portal group-hover:scale-y-100"
    aria-hidden="true"></span>

  <div class="grid gap-8 pl-6 lg:grid-cols-[13rem_1fr] lg:gap-12">
    <!-- Index + period + status -->
    <div>
      <p
        class="font-display text-[3.4rem] font-semibold leading-none tracking-[-0.04em] text-amethyst transition-colors duration-500 group-hover:text-glow/70"
      >
        {String(index + 1).padStart(2, "0")}
      </p>

      <p class="mt-4 font-sans text-[0.75rem] uppercase tracking-[0.16em] text-mist">
        {period}
      </p>

      <p class="mt-3 inline-flex items-center gap-1.5 font-sans text-[0.68rem] uppercase tracking-[0.14em] text-nebula">
        <span class="size-1.5 rounded-full bg-nebula"></span>
        {status}
      </p>
    </div>

    <!-- The work -->
    <div>
      <div class="flex items-start justify-between gap-6">
        <h2 class="text-h2 text-starlight transition-colors duration-500 group-hover:text-glow">
          {title}
        </h2>
        <Icon
          name="arrow-up-right"
          class="mt-2 size-7 shrink-0 text-amethyst-mist transition-all duration-500 ease-portal group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-glow"
        />
      </div>

      {role && <p class="mt-3 font-sans text-[0.78rem] uppercase tracking-[0.12em] text-dim">{role}</p>}

      <p class="mt-5 max-w-2xl text-body-lg leading-relaxed text-mist">{summary}</p>

      {
        metrics.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-x-10 gap-y-5">
            {metrics.map((metric) => (
              <li>
                <p class="font-display text-[1.6rem] font-semibold leading-none tracking-[-0.02em] text-glow">{metric.value}</p>
                <p class="mt-1.5 text-[0.78rem] text-dim">{metric.label}</p>
              </li>
            ))}
          </ul>
        )
      }

      {
        tags.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="chip">{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</a>
