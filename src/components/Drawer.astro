---
import { LINKS, SITE, SOCIALS } from "@consts"
import { cn } from "@lib/utils"
import Icon from "@components/Icon.astro"

const { pathname } = Astro.url
const root = "/" + (pathname.match(/[^/]+/g)?.[0] ?? "")
const isActive = (href: string) => pathname === href || root === href
---

<div
  id="drawer"
  class="fixed inset-x-0 top-0 z-40 bg-void/95 lg:hidden"
  aria-label="Mobile navigation"
>
  <div class="flex h-[100dvh] flex-col justify-between px-8 pb-10 pt-28">
    <nav>
      <ul class="flex flex-col gap-1">
        {
          LINKS.map((link, i) => (
            <li>
              <a
                href={link.HREF}
                aria-current={isActive(link.HREF) ? "page" : undefined}
                class={cn(
                  "group flex items-baseline gap-4 border-b border-[--line] py-5 font-display text-[2rem] transition-colors duration-300",
                  isActive(link.HREF) ? "text-glow" : "text-starlight hover:text-glow",
                )}
              >
                <span class="font-sans text-[0.7rem] tracking-[0.2em] text-glow/50">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {link.TEXT}
                <Icon
                  name="arrow-up-right"
                  class="ml-auto size-6 translate-y-1 opacity-0 transition-all duration-500 ease-portal group-hover:translate-y-0 group-hover:opacity-100"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="space-y-6">
      <a href={SITE.CV} download class="btn btn-primary w-full">
        <Icon name="download" class="size-4" />
        Download CV
      </a>

      <div class="flex items-center justify-center gap-3">
        {
          SOCIALS.map((social) => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.NAME}
              class="grid size-11 place-items-center rounded-full border border-[--line] text-mist transition-colors duration-300 hover:border-glow/50 hover:text-glow"
            >
              <Icon name={social.ICON} sprite="social" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</div>
