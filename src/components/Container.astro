---
import { cn } from "@lib/utils"

type Props = {
  size?: "narrow" | "reading" | "default" | "wide"
  class?: string
}

const { size = "default", class: className } = Astro.props
---

<div
  class={cn(
    "mx-auto w-full px-6 sm:px-8",
    size === "narrow" && "max-w-2xl",
    size === "reading" && "max-w-3xl",
    size === "default" && "max-w-5xl",
    size === "wide" && "max-w-shell",
    className,
  )}
>
  <slot />
</div>
