---
import { ViewTransitions } from "astro:transitions"
import { SERVICES, SITE, SOCIALS } from "@consts"

type Props = {
  /** The browser tab and <title> — just the site name, by design */
  title: string
  /** Page title without the site suffix — used for structured data */
  rawTitle?: string
  /** Descriptive title used only on Open Graph and Twitter cards */
  socialTitle?: string
  description: string
  image?: string
  /** Present on blog posts and project case studies */
  article?: {
    published: Date
    modified?: Date
    section?: string
    tags?: string[]
  }
  /** Trail shown to search engines, e.g. Blog → Post title */
  breadcrumbs?: { name: string; href: string }[]
}

const {
  title,
  rawTitle,
  socialTitle,
  description,
  image = "/open-graph.jpg",
  article,
  breadcrumbs,
} = Astro.props

/* Structured data wants the clean page or article title; a shared link
   wants the descriptive one. They are not the same string. */
const headline = rawTitle ?? title
const shareTitle = socialTitle ?? headline

const canonical = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL(image, Astro.site)
const origin = new URL(Astro.site!).origin

/* ── Structured data ──────────────────────────────────────────
   One @graph so Google can resolve the relationships between the
   person, the site and the page instead of guessing.            */
const person = {
  "@type": "Person",
  "@id": `${origin}/#person`,
  name: SITE.NAME,
  alternateName: SITE.TITLE,
  givenName: "Sergiu",
  familyName: "Mocan",
  url: origin,
  image: new URL("/open-graph.jpg", Astro.site).href,
  jobTitle: SITE.JOB_TITLE,
  description: SITE.META_DESCRIPTION,
  email: `mailto:${SITE.EMAIL}`,
  telephone: SITE.PHONE,
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.CITY,
    addressRegion: SITE.REGION,
    addressCountry: SITE.COUNTRY,
  },
  workLocation: { "@type": "Place", name: SITE.LOCATION },
  ...(SITE.AVAILABLE ? { seeks: { "@type": "Demand", name: SITE.AVAILABILITY } } : {}),
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Babeș-Bolyai University",
  },
  knowsLanguage: ["en", "ro"],
  knowsAbout: [
    ".NET",
    ".NET Core",
    "ASP.NET Core",
    "C#",
    "Entity Framework Core",
    "AWS",
    "AWS CDK",
    "Amazon ECS",
    "AWS Fargate",
    "Amazon SQS",
    "Cloud migration",
    "Microservices",
    "Distributed systems",
    "Event-driven architecture",
    "Clean Architecture",
    "Domain-driven design",
    "Docker",
    "Kubernetes",
    "CI/CD",
    "TypeScript",
    "React",
    "Node.js",
    "SQL Server",
    "PostgreSQL",
    "Redis",
    "Solidity",
    "Ethereum",
    "Smart contracts",
    "Machine learning",
    "Computer vision",
  ],
  /* What a client can buy. This is the part that answers commercial
     searches like "hire .NET developer" rather than just the name. */
  makesOffer: SERVICES.map((service) => ({
    "@type": "Offer",
    itemOffered: {
      "@type": "Service",
      name: service.NAME,
      description: service.DESCRIPTION,
      provider: { "@id": `${origin}/#person` },
      areaServed: [
        { "@type": "Country", name: "Romania" },
        { "@type": "Place", name: "Remote / Worldwide" },
      ],
    },
  })),
  sameAs: SOCIALS.filter((social) => social.HREF.startsWith("http")).map((social) => social.HREF),
}

/* A distinct commercial entity, so the freelance side of the site is
   legible to search engines as a service business, not only a CV. */
const practice = {
  "@type": "ProfessionalService",
  "@id": `${origin}/#practice`,
  name: `${SITE.TITLE} — Software Engineering`,
  description:
    "Freelance software engineering: .NET and AWS back ends, full-stack web applications, smart contracts and machine-learning systems.",
  url: origin,
  image: new URL("/open-graph.jpg", Astro.site).href,
  founder: { "@id": `${origin}/#person` },
  email: `mailto:${SITE.EMAIL}`,
  telephone: SITE.PHONE,
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.CITY,
    addressRegion: SITE.REGION,
    addressCountry: SITE.COUNTRY,
  },
  areaServed: [
    { "@type": "Country", name: "Romania" },
    { "@type": "Place", name: "Remote / Worldwide" },
  ],
  knowsAbout: SERVICES.map((service) => service.NAME),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Software engineering services",
    itemListElement: SERVICES.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.NAME,
        description: service.DESCRIPTION,
      },
    })),
  },
}

const website = {
  "@type": "WebSite",
  "@id": `${origin}/#website`,
  url: origin,
  name: SITE.TITLE,
  description: SITE.DESCRIPTION,
  inLanguage: "en",
  publisher: { "@id": `${origin}/#person` },
}

const page = article
  ? {
      "@type": "BlogPosting",
      "@id": `${canonical.href}#article`,
      headline,
      description,
      image: socialImage.href,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      articleSection: article.section,
      keywords: article.tags?.join(", "),
      inLanguage: "en",
      author: { "@id": `${origin}/#person` },
      publisher: { "@id": `${origin}/#person` },
      isPartOf: { "@id": `${origin}/#website` },
      mainEntityOfPage: canonical.href,
    }
  : {
      "@type": "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: headline,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${origin}/#website` },
      about: { "@id": `${origin}/#person` },
    }

const trail = breadcrumbs?.length
  ? [
      {
        "@type": "BreadcrumbList",
        "@id": `${canonical.href}#breadcrumbs`,
        itemListElement: [{ name: "Home", href: "/" }, ...breadcrumbs].map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.name,
          item: new URL(crumb.href, Astro.site).href,
        })),
      },
    ]
  : []

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [person, practice, website, page, ...trail],
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0A0A0C" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.AUTHOR} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.TITLE} — Blog`}
  href={new URL("rss.xml", Astro.site)}
/>

<!-- Typography: one family, four weights -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
/>

<!-- Open Graph -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={SITE.TITLE} />
<meta property="og:locale" content="en_GB" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={shareTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.NAME} — ${SITE.ROLE}`} />

<!-- Identity links: these tie the profiles together for search engines,
     which is most of what makes a name query resolve to the right person. -->
{
  SOCIALS.filter((social) => social.HREF.startsWith("http")).map((social) => (
    <link rel="me" href={social.HREF} />
  ))
}

{
  article && (
    <>
      <meta property="article:author" content={SITE.AUTHOR} />
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.modified && (
        <meta property="article:modified_time" content={article.modified.toISOString()} />
      )}
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={shareTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={`${SITE.NAME} — ${SITE.ROLE}`} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<script is:inline defer src="/js/atmosphere.js"></script>
<script defer is:inline src="/js/copy.js"></script>

<ViewTransitions />
