---
import { cn } from "@lib/utils"

type Props = {
  name: string
  /** Which sprite sheet the symbol lives in */
  sprite?: "ui" | "social" | "brand"
  class?: string
}

const { name, sprite = "ui", class: className } = Astro.props
---

<svg class={cn("size-5 shrink-0", className)} aria-hidden="true" focusable="false">
  <use href={`/${sprite}.svg#${name}`}></use>
</svg>
