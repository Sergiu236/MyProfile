---
import { LINKS, SITE, SOCIALS } from "@consts"
import Container from "@components/Container.astro"
import Icon from "@components/Icon.astro"

const year = new Date().getFullYear()
---

<footer class="relative z-10 mt-32 border-t border-[--line]">
  <!-- A last band of light along the seam -->
  <div class="absolute inset-x-0 -top-px h-px bg-hairline"></div>

  <Container size="wide" class="py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Identity -->
      <div>
        <a href="/" class="group inline-flex items-center gap-3">
          <Icon
            name="brand"
            sprite="brand"
            class="size-8 text-glow transition-transform duration-700 ease-portal group-hover:rotate-[120deg]"
          />
          <span class="font-display text-[1.35rem] font-semibold tracking-[-0.02em] text-starlight">{SITE.TITLE}</span>
        </a>
        <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-dim">
          Building cloud-native systems from Cluj-Napoca — and writing about what breaks along the
          way.
        </p>

        <div class="mt-6 flex items-center gap-2.5">
          <span class="relative flex size-2.5">
            <span
              class="absolute inline-flex size-full animate-ping rounded-full bg-nebula opacity-60"
            ></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-nebula"></span>
          </span>
          <span class="font-sans text-[0.75rem] uppercase tracking-[0.14em] text-mist">
            {SITE.AVAILABILITY}
          </span>
        </div>
      </div>

      <!-- Navigation -->
      <nav aria-label="Footer">
        <h2 class="eyebrow">Navigate</h2>
        <ul class="mt-5 space-y-3">
          {
            LINKS.map((link) => (
              <li>
                <a href={link.HREF} class="link-glow text-[0.98rem] text-mist">
                  {link.TEXT}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/search" class="link-glow text-[0.98rem] text-mist">Search</a>
          </li>
        </ul>
      </nav>

      <!-- Elsewhere -->
      <div>
        <h2 class="eyebrow">Elsewhere</h2>
        <ul class="mt-5 space-y-3">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.HREF}
                  target={social.ICON === "mail" ? undefined : "_blank"}
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2.5 text-[0.98rem] text-mist transition-colors duration-300 hover:text-glow"
                >
                  <Icon name={social.ICON} sprite="social" class="size-4" />
                  {social.NAME}
                  <Icon
                    name="arrow-up-right"
                    class="size-3.5 -translate-x-1 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                  />
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/rss.xml"
              target="_blank"
              class="group inline-flex items-center gap-2.5 text-[0.98rem] text-mist transition-colors duration-300 hover:text-glow"
            >
              <Icon name="rss" class="size-4" />
              RSS
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col-reverse items-center justify-between gap-6 border-t border-[--line] pt-8 sm:flex-row"
    >
      <p class="font-sans text-[0.72rem] uppercase tracking-[0.14em] text-dim">
        © {year} {SITE.NAME}
      </p>

      <button
        id="back-to-top"
        type="button"
        class="group inline-flex items-center gap-2 font-sans text-[0.72rem] uppercase tracking-[0.14em] text-dim transition-colors duration-300 hover:text-glow"
      >
        <Icon
          name="arrow-down"
          class="size-4 rotate-180 transition-transform duration-500 ease-portal group-hover:-translate-y-1"
        />
        Back to orbit
      </button>
    </div>
  </Container>
</footer>
